<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Quest Master</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
            min-height: 100vh;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .pop-anim {
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .shake-anim {
            animation: shake 0.4s ease-in-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
    </style>
</head>
<body class="text-white flex flex-col items-center justify-center p-4">

    <div id="app" class="w-full max-w-md mx-auto">

        <!-- HEADER / BRANDING -->
        <header class="text-center mb-6">
            <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-amber-400 to-rose-400 bg-clip-text text-transparent">
                Math Quest Master
            </h1>
            <p class="text-indigo-200 text-sm mt-1">Asah Otakmu dengan Petualangan Angka</p>
        </header>

        <!-- START SCREEN -->
        <div id="start-screen" class="glass-panel rounded-3xl p-6 shadow-2xl text-center pop-anim">
            <div class="mb-6 flex justify-center">
                <div class="w-20 h-20 bg-indigo-500/30 rounded-full flex items-center justify-center border border-indigo-400/30">
                    <span class="text-4xl">🧠</span>
                </div>
            </div>
            <h2 class="text-xl font-bold mb-2">Pilih Mode Kesulitan</h2>
            <p class="text-xs text-indigo-200 mb-6">Setiap mode memiliki batas waktu dan tantangan unik!</p>
            
            <div class="space-y-3 mb-6">
                <button onclick="startGame('easy')" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 rounded-xl font-semibold transition shadow-lg flex items-center justify-between">
                    <span>🌱 Mode Pemula (+, -)</span>
                    <span class="text-xs bg-emerald-700 px-2 py-1 rounded-lg">Santai</span>
                </button>
                <button onclick="startGame('medium')" class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-500 rounded-xl font-semibold transition shadow-lg flex items-center justify-between">
                    <span>⚡ Mode Menengah (+, -, ×)</span>
                    <span class="text-xs bg-amber-700 px-2 py-1 rounded-lg">Standar</span>
                </button>
                <button onclick="startGame('hard')" class="w-full py-3 px-4 bg-rose-600 hover:bg-rose-500 rounded-xl font-semibold transition shadow-lg flex items-center justify-between">
                    <span>🔥 Mode Master (Semua + ÷)</span>
                    <span class="text-xs bg-rose-700 px-2 py-1 rounded-lg">Tantangan</span>
                </button>
            </div>
            <button onclick="showLeaderboard()" class="text-xs text-indigo-300 underline hover:text-white transition">Lihat Papan Skor Terbaik</button>
        </div>

        <!-- GAME SCREEN -->
        <div id="game-screen" class="glass-panel rounded-3xl p-6 shadow-2xl hidden pop-anim">
            <!-- Game Top Bar -->
            <div class="flex justify-between items-center mb-6 text-sm bg-indigo-950/40 p-3 rounded-2xl border border-indigo-500/20">
                <div>
                    <span class="text-indigo-300 block text-xs">Skor</span>
                    <span id="score-display" class="font-bold text-lg text-amber-400">0</span>
                </div>
                <div class="text-center">
                    <span class="text-indigo-300 block text-xs">Waktu</span>
                    <span id="timer-display" class="font-bold text-lg text-emerald-400">15s</span>
                </div>
                <div class="text-right">
                    <span class="text-indigo-300 block text-xs">Soal</span>
                    <span id="progress-display" class="font-bold text-lg">1/10</span>
                </div>
            </div>

            <!-- Timer Progress Bar -->
            <div class="w-full bg-indigo-950/60 h-2 rounded-full mb-6 overflow-hidden">
                <div id="timer-bar" class="bg-gradient-to-r from-emerald-400 to-amber-400 h-full w-full transition-all duration-1000"></div>
            </div>

            <!-- Question Box -->
            <div class="bg-indigo-900/50 rounded-2xl p-6 text-center mb-6 border border-indigo-400/20 shadow-inner">
                <span id="question-text" class="text-4xl font-extrabold tracking-wider text-amber-200">12 + 8</span>
            </div>

            <!-- Options Grid -->
            <div id="options-container" class="grid grid-cols-2 gap-3 mb-4">
                <!-- Dynamically generated buttons -->
            </div>

            <button onclick="quitGame()" class="w-full text-center text-xs text-rose-300 hover:text-rose-200 mt-2 py-1">Keluar ke Menu</button>
        </div>

        <!-- GAME OVER / SUMMARY SCREEN -->
        <div id="gameover-screen" class="glass-panel rounded-3xl p-6 shadow-2xl hidden text-center pop-anim">
            <div class="mb-4">
                <div id="result-emoji" class="text-6xl mb-2">🎉</div>
                <h2 id="result-title" class="text-2xl font-bold">Permainan Selesai!</h2>
                <p id="result-subtitle" class="text-xs text-indigo-200 mt-1">Kerja bagus, otakmu luar biasa aktif!</p>
            </div>

            <div class="bg-indigo-950/40 rounded-2xl p-4 mb-6 border border-indigo-500/20 space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-indigo-300">Skor Akhir:</span>
                    <span id="final-score" class="font-bold text-amber-400">0</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-indigo-300">Jawaban Benar:</span>
                    <span id="final-correct" class="font-bold text-emerald-400">0 / 10</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-indigo-300">Akurasi:</span>
                    <span id="final-accuracy" class="font-bold text-cyan-400">0%</span>
                </div>
            </div>

            <div class="space-y-3">
                <button onclick="restartGame()" class="w-full py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 rounded-xl font-semibold transition shadow-lg">
                    Main Lagi
                </button>
                <button onclick="goToMenu()" class="w-full py-3 bg-indigo-950/60 hover:bg-indigo-900 rounded-xl font-semibold transition border border-indigo-500/20">
                    Menu Utama
                </button>
            </div>
        </div>

        <!-- LEADERBOARD MODAL SCREEN -->
        <div id="leaderboard-screen" class="glass-panel rounded-3xl p-6 shadow-2xl hidden pop-anim">
            <h2 class="text-xl font-bold mb-4 text-center">🏆 Skor Terbaik Lokal</h2>
            <div id="leaderboard-list" class="space-y-2 mb-6 max-h-60 overflow-y-auto pr-1">
                <!-- Filled via JS -->
            </div>
            <button onclick="hideLeaderboard()" class="w-full py-3 bg-indigo-950/60 hover:bg-indigo-900 rounded-xl font-semibold transition border border-indigo-500/20">
                Kembali
            </button>
        </div>

        <!-- CUSTOM MESSAGE BOX (Alternative to alert) -->
        <div id="custom-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
            <div class="glass-panel rounded-3xl p-6 max-w-xs w-full text-center pop-anim border border-white/20">
                <h3 id="modal-title" class="text-lg font-bold mb-2">Informasi</h3>
                <p id="modal-message" class="text-sm text-indigo-200 mb-6">Pesan sistem...</p>
                <button onclick="closeModal()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-semibold transition shadow-lg">OK</button>
            </div>
        </div>

    </div>

    <script>
        // Game State Variables
        let currentMode = 'easy';
        let score = 0;
        let currentQuestionIndex = 0;
        let totalQuestions = 10;
        let correctAnswersCount = 0;
        let timeLeft = 15;
        let timerInterval = null;
        let correctAnswer = 0;
        let isAnswerLocked = false;

        // Sound / Haptic simulations via subtle animations
        function showMessage(title, message) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerText = message;
            document.getElementById('custom-modal').classList.remove('hidden');
            document.getElementById('custom-modal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.remove('flex');
            document.getElementById('custom-modal').classList.add('hidden');
        }

        function startGame(mode) {
            currentMode = mode;
            score = 0;
            currentQuestionIndex = 0;
            correctAnswersCount = 0;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-screen').classList.remove('hidden');
            
            nextQuestion();
        }

        function quitGame() {
            clearInterval(timerInterval);
            document.getElementById('game-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }

        function nextQuestion() {
            if (currentQuestionIndex >= totalQuestions) {
                endGame();
                return;
            }

            currentQuestionIndex++;
            isAnswerLocked = false;
            document.getElementById('progress-display').innerText = `${currentQuestionIndex}/${totalQuestions}`;
            document.getElementById('score-display').innerText = score;

            // Generate Question based on mode
            let qData = generateMathProblem(currentMode);
            correctAnswer = qData.answer;
            document.getElementById('question-text').innerText = qData.questionString;

            // Generate options
            let options = generateOptions(correctAnswer);
            let optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            options.forEach(opt => {
                let btn = document.createElement('button');
                btn.className = "py-4 bg-indigo-900/60 hover:bg-indigo-800/80 active:scale-95 transition rounded-2xl text-xl font-bold border border-indigo-400/20 shadow-md";
                btn.innerText = opt;
                btn.onclick = () => checkAnswer(opt, btn);
                optionsContainer.appendChild(btn);
            });

            // Reset Timer
            clearInterval(timerInterval);
            timeLeft = currentMode === 'hard' ? 10 : (currentMode === 'medium' ? 15 : 20);
            updateTimerDisplay();
            
            timerInterval = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    handleTimeOut();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            document.getElementById('timer-display').innerText = `${timeLeft}s`;
            let percentage = (timeLeft / (currentMode === 'hard' ? 10 : (currentMode === 'medium' ? 15 : 20))) * 100;
            document.getElementById('timer-bar').style.width = `${percentage}%`;
        }

        function generateMathProblem(mode) {
            let num1, num2, op, ans;
            if (mode === 'easy') {
                // Addition & Subtraction up to 20
                op = Math.random() > 0.5 ? '+' : '-';
                num1 = Math.floor(Math.random() * 20) + 1;
                num2 = Math.floor(Math.random() * 20) + 1;
                if (op === '-' && num1 < num2) { [num1, num2] = [num2, num1]; }
                ans = op === '+' ? num1 + num2 : num1 - num2;
            } else if (mode === 'medium') {
                // Addition, Subtraction, Multiplication up to 50 / tables to 10
                const ops = ['+', '-', '×'];
                op = ops[Math.floor(Math.random() * ops.length)];
                if (op === '×') {
                    num1 = Math.floor(Math.random() * 10) + 1;
                    num2 = Math.floor(Math.random() * 10) + 1;
                    ans = num1 * num2;
                } else {
                    num1 = Math.floor(Math.random() * 50) + 10;
                    num2 = Math.floor(Math.random() * 50) + 10;
                    if (op === '-' && num1 < num2) { [num1, num2] = [num2, num1]; }
                    ans = op === '+' ? num1 + num2 : num1 - num2;
                }
            } else {
                // Hard: All including division and larger numbers
                const ops = ['+', '-', '×', '÷'];
                op = ops[Math.floor(Math.random() * ops.length)];
                if (op === '÷') {
                    num2 = Math.floor(Math.random() * 10) + 2;
                    let multiplier = Math.floor(Math.random() * 12) + 1;
                    num1 = num2 * multiplier;
                    ans = multiplier;
                } else if (op === '×') {
                    num1 = Math.floor(Math.random() * 12) + 4;
                    num2 = Math.floor(Math.random() * 12) + 4;
                    ans = num1 * num2;
                } else {
                    num1 = Math.floor(Math.random() * 90) + 10;
                    num2 = Math.floor(Math.random() * 90) + 10;
                    if (op === '-' && num1 < num2) { [num1, num2] = [num2, num1]; }
                    ans = op === '+' ? num1 + num2 : num1 - num2;
                }
            }
            return {
                questionString: `${num1} ${op} ${num2}`,
                answer: ans
            };
        }

        function generateOptions(correct) {
            let opts = [correct];
            while (opts.length < 4) {
                let offset = (Math.floor(Math.random() * 10) + 1) * (Math.random() > 0.5 ? 1 : -1);
                let wrongOpt = correct + offset;
                if (wrongOpt >= 0 && !opts.includes(wrongOpt)) {
                    opts.push(wrongOpt);
                }
            }
            // Shuffle options
            return opts.sort(() => Math.random() - 0.5);
        }

        function checkAnswer(selected, btnElement) {
            if (isAnswerLocked) return;
            isAnswerLocked = true;
            clearInterval(timerInterval);

            if (selected === correctAnswer) {
                correctAnswersCount++;
                score += (timeLeft * 10) + 50;
                btnElement.classList.remove('bg-indigo-900/60');
                btnElement.classList.add('bg-emerald-600', 'border-emerald-400');
            } else {
                btnElement.classList.remove('bg-indigo-900/60');
                btnElement.classList.add('bg-rose-600', 'border-rose-400', 'shake-anim');
                
                // Highlight correct button
                let buttons = document.getElementById('options-container').children;
                for (let b of buttons) {
                    if (parseInt(b.innerText) === correctAnswer) {
                        b.classList.add('bg-emerald-600/70', 'border-emerald-400');
                    }
                }
            }

            setTimeout(() => {
                nextQuestion();
            }, 900);
        }

        function handleTimeOut() {
            if (isAnswerLocked) return;
            isAnswerLocked = true;

            let buttons = document.getElementById('options-container').children;
            for (let b of buttons) {
                if (parseInt(b.innerText) === correctAnswer) {
                    b.classList.add('bg-amber-600/70', 'border-amber-400');
                }
            }

            setTimeout(() => {
                nextQuestion();
            }, 1000);
        }

        function endGame() {
            clearInterval(timerInterval);
            document.getElementById('game-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.remove('hidden');

            document.getElementById('final-score').innerText = score;
            document.getElementById('final-correct').innerText = `${correctAnswersCount} / ${totalQuestions}`;
            let accuracy = Math.round((correctAnswersCount / totalQuestions) * 100);
            document.getElementById('final-accuracy').innerText = `${accuracy}%`;

            let emoji = "🎉";
            let title = "Luar Biasa!";
            let subtitle = "Kemampuan matematikamu sangat tajam!";
            if (accuracy < 50) {
                emoji = "💪";
                title = "Terus Berlatih!";
                subtitle = "Jangan menyerah, ulangi untuk skor lebih baik!";
            } else if (accuracy === 100) {
                emoji = "🏆";
                title = "Sempurna!";
                subtitle = "Kamu adalah seorang Master Matematika sejati!";
            }

            document.getElementById('result-emoji').innerText = emoji;
            document.getElementById('result-title').innerText = title;
            document.getElementById('result-subtitle').innerText = subtitle;

            saveScoreToLeaderboard(score, currentMode);
        }

        function restartGame() {
            document.getElementById('gameover-screen').classList.add('hidden');
            startGame(currentMode);
        }

        function goToMenu() {
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }

        // Local Storage Leaderboard
        function saveScoreToLeaderboard(finalScore, mode) {
            let lb = JSON.parse(localStorage.getItem('math_quest_lb') || '[]');
            lb.push({ score: finalScore, mode: mode, date: new Date().toLocaleDateString() });
            lb.sort((a, b) => b.score - a.score);
            lb = lb.slice(0, 5); // Keep top 5
            localStorage.setItem('math_quest_lb', JSON.stringify(lb));
        }

        function showLeaderboard() {
            let lb = JSON.parse(localStorage.getItem('math_quest_lb') || '[]');
            let listContainer = document.getElementById('leaderboard-list');
            listContainer.innerHTML = '';

            if (lb.length === 0) {
                listContainer.innerHTML = '<p class="text-xs text-indigo-300 text-center py-4">Belum ada skor tersimpan.</p>';
            } else {
                lb.forEach((item, index) => {
                    let div = document.createElement('div');
                    div.className = "flex justify-between items-center bg-indigo-900/40 p-3 rounded-xl border border-indigo-500/10 text-sm";
                    div.innerHTML = `
                        <span class="font-bold text-amber-400">#${index + 1} (${item.mode.toUpperCase()})</span>
                        <span class="font-bold text-white">${item.score} Poin</span>
                    `;
                    listContainer.appendChild(div);
                });
            }

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('leaderboard-screen').classList.remove('hidden');
        }

        function hideLeaderboard() {
            document.getElementById('leaderboard-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }
    </script>
</body>
</html>